extern attribute noRecogName;   /// The object is not matched by the words of its printed name.

/// Test the typed word at `wordnumber` against the object's printed name: 1 when it is there, -1 when not. For use in a `parse_name`.
extern int MatchAgainstShortName(object obj, int wordnumber);

#include "_orHookInformLibrary"
#include "_orHookStandardLibrary"
#includeI6 "orRecogName";
