/* -----------------------------------------------------------------------------
    orUtilChar.bgl - Bindings for orLibrary's orUtilChar extension
    util.orChar: tell what kind of character one is, and change its case.
    Accented letters count as letters.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "_orUtil"

/// Character helpers, reached as `util.orChar`.
extern class _orChar : object {
    emitter bool isAlpha(char c)        { ($self.isAlpha($c)) }          /// True when it is a letter.
    emitter bool isNumeric(char c)      { ($self.isNumeric($c)) }        /// True when it is a digit.
    emitter bool isAlphaNumeric(char c) { ($self.isAlphaNumeric($c)) }   /// True when it is a letter or a digit.
    emitter bool isVowel(char c)        { ($self.isVowel($c)) }          /// True when it is a vowel.
    emitter bool isConsonant(char c)    { ($self.isConsonant($c)) }      /// True when it is a consonant.
    emitter bool isLower(char c)        { ($self.isLower($c)) }          /// True when it is a lower-case letter.
    emitter bool isUpper(char c)        { ($self.isUpper($c)) }          /// True when it is an upper-case letter.
    emitter char toUpper(char c)        { ($self.toUpper($c)) }          /// The upper-case letter, or the character itself when it is not a letter.
    emitter char toLower(char c)        { ($self.toLower($c)) }          /// The lower-case letter, or the character itself when it is not a letter.
}
// Add orChar to the util object
extend class _orUtil {
    ref _orChar orChar;
}

#includeI6 "orUtilChar";
