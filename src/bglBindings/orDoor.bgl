//===================================================================================================
// bindings/orDoor.bgl — Beguile binding for orLibrary's orDoor extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. The orDoor type is bound at the bottom.
//===================================================================================================
#once
// dependency bindings — mirror orDoor.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "orString"
#include "_orInfExt"
// Beguile main-handoff: this binding reaches _orHookInformLibrary (orLibrary then drops its own `replace main`/[Main] under a Beguile compile), so pull pkgOrHooks for the #startup that wires __orBeguileMainInit into bglInit. #once-guarded; harmless if pulled more than once.
#include "pkgOrHooks"

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orDoor";

// The orDoor type (I6 `class orDoor has static door openable scenery`). A simple two-room door: set
// `found_in = {roomA, roomB}` and the class computes `door_to`/`door_dir` automatically, so a room's
// direction exit can point straight at the door. Add `name`/`short_name`/`description` and attribute
// overrides (`{!open, locked}`, etc.) as needed; `before()`/`after()` intercept actions like any object.
extern class orDoor : object {
    array<object>         found_in;     // the two rooms the door connects (drives door_to/door_dir)
    array<dictionaryWord> name;         // parser vocabulary
    string                short_name;   // printed name
    string                description;  // examine text (string, or override with a `bool description()` routine)
}
