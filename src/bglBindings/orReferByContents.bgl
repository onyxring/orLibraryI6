/* -----------------------------------------------------------------------------
    orReferByContents.bgl - Bindings for orLibrary's orReferByContents extension
    A container the player can refer to by what is inside it: TAKE WATER for a
    glass of water.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilParser"

/// A container that answers to the names of its contents.
extern class orReferByContents : object {
    array<var> referActions;    /// The actions this applies to; take, drop and insert by default.
    array<var> ignoreActions;   /// The actions this never applies to.
}

#include "_orHookInformLibrary"
#includeI6 "orReferByContents";
