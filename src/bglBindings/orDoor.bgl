/* -----------------------------------------------------------------------------
    orDoor.bgl - Bindings for orLibrary's orDoor extension
    A door between two rooms that works out its own direction and destination.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "_orHookInformLibrary"
#includeI6 "orDoor";

/// A door between the two rooms in `found_in`; a room's exit can name the door itself.
extern class orDoor : object {
    rawArray<object>         found_in;      /// The two rooms the door connects.
    rawArray<dictionaryWord> name;          /// The words the player can call it.
    string                   short_name;    /// Its printed name.
    string                   description;   /// The text shown when it is examined.
}
