/* -----------------------------------------------------------------------------
    orMenu.bgl - Bindings for orLibrary's orMenu extension
    A scrolling menu system for help and about screens. A menu is a tree of
    orMenu objects; show the root to open it.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orCenter"
#include "orUtilRef"
#include "orUtilUi"
#include "_orInfExt"

//-- Constants -------------------------------------------
extern const int orMenuFullScreen;   /// Display style: the menu takes over the whole screen.
extern const int orMenuTopOnly;      /// Display style: the menu is drawn in the status area only.

//-- Classes ---------------------------------------------
/// A menu entry, titled by its `short_name`. Its children are its submenu; a leaf shows its `description`, or runs its `rawDescription()`.
extern class orMenu : object {
    int    displayStyle;   /// The display style in use: `orMenuFullScreen` or `orMenuTopOnly`.
    int    itemWindowId;   /// On Glulx, a window to draw the items in; 0 draws them in the status bar.
    string menuDisplay;    /// The entry's text in its parent's menu; its `short_name` when unset.
    emitter object show()  { ($self.show()) }   /// Open this menu full screen; gives the entry chosen, or nothing if the player left.
    emitter object show(int showStyle)  { ($self.show($showStyle)) }   /// Open this menu in the given display style; gives the entry chosen, or nothing.
    emitter void show(object rootMenu, int showStyle)  { $self.show($rootMenu, $showStyle) }   /// Open `rootMenu` in the given display style.
}

#include "_orHookInformLibrary"
#includeI6 "orMenu";
