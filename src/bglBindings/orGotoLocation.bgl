//===================================================================================================
// bindings/orGotoLocation.bgl — Beguile binding for orLibrary's orGotoLocation extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orGotoLocation adds a "GO TO <room>" verb that path-finds from the player's
// location to a named room and queues the movement commands to walk there.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
// dependency bindings — mirror orGotoLocation.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "orUtilMapPathFinder"
#include "orPlayerCommandQueue"
#include "_orHookInformLibrary"   // this extension's I6 brings in _orHookInformLibrary: its play-loop setup must run

// The GO-TO action — register the name so before()/react_before() can intercept it (##gotoLocation).
extern verb gotoLocation;

// When true (the default), only rooms the player has already visited (beenSeen) are in scope for
// "go to"; set false to allow travelling to any room on the map.
extern bool orPathFinderAvoidUnvisitedLocations;

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orGotoLocation";
