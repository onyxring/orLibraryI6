/* -----------------------------------------------------------------------------
    orExits.bgl - Bindings for orLibrary's orExits extension
    An EXITS verb that lists the obvious exits from the current room.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"

extern verb Exits { }   /// The action of listing the exits.

extern property exitsText;   /// A room's own description of its exits: a string, or a routine that prints it.

/// Print the obvious exits from the current room. `qualifier` is worked into the sentence; `ignoreExitsText` skips a room's `exitsText`.
extern void DescribeExits(string qualifier = 0, bool ignoreExitsText = false);

#includeI6 "orExits";
