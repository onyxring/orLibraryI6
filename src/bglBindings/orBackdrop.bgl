/* -----------------------------------------------------------------------------
    orBackdrop.bgl - Bindings for orLibrary's orBackdrop extension
    Scenery by keyword: a room or backdrop object lists its scenery in a `backdrops`
    array, and the player's words pick the entry that answers.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "orUtilArray"
#include "orUtilRef"
#include "orBetterChoice"

//-- Constants ------------------------------------------
extern const int bdEnd;          /// Ends an entry in a `backdrops` array.
extern const int bdDefault;      /// Marks the catch-all entry.
//FOR REVIEW [B-03] bdDescr doesn't introduce a description: it follows the entry's one text, used for both. Replaces the next 1 line:
//    extern const int bdDescr;      // 1 — after an entry's only text: use it as both the description and the reply
extern const int bdDescr;        /// Introduces a description string for the current entry.
extern const int bdRedirected;   /// Returned by an entry's routine that ran another action.

//-- Classes ------------------------------------------
/// A set of scenery entries that can float between rooms; give it a `backdrops` array.
extern class orBackdrop : object {
    rawArray<object> found_in;   /// The rooms it floats in; omit for a single room set as its parent.
}

//-- Objects ------------------------------------------
/// The engine that resolves the player's words to a backdrop entry.
extern object orBackdropEngine {
    dictionaryWord getKeyword();            /// The word the player used for the backdrop being resolved.
    void registerDescriptionVerb(verb v);   /// Make an action print a backdrop's description, as examine does.
}

#include "_orHookStandardLibrary"
#includeI6 "orBackdrop";
