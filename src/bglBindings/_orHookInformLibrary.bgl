/* -----------------------------------------------------------------------------
    _orHookInformLibrary.bgl - Bindings for orLibrary's _orHookInformLibrary hook
    Gives orLibrary's extensions their play-loop hooks through Beguile's own hook extension,
    and registers every orInfExt object when the game starts.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include <extensions/stdlib/hooks/informLibrary>

// Keep orLibrary's own copy of the hook out
#emitfirst {
    Constant orHookInformLibrary_STAGE 99; #ifdef orHookInformLibrary_STAGE; #endif;
}

#includeI6 "_orInfExt";

// Register the orInfExt objects
#emitlast {
    [ __orBeguileMainInit;
        #ifdef allocateInformExtensions;
            allocateInformExtensions();
        #endif;
    ];
}

// Run the registration when the game starts
#startup {
    __orBeguileMainInit();
}
