//===================================================================================================
// bindings/orPlayerCommandQueue.bgl — Beguile binding for orLibrary's orPlayerCommandQueue extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orPlayerCommandQueue lets code enqueue commands to run on the player's behalf
// (walkthroughs, "go to" routing, direction/look redirects) via the `playerCommands` action queue.
//===================================================================================================
#once
// dependency bindings — mirror orPlayerCommandQueue.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "_orInfExt"
#include "orUtilBuf"
// Beguile main-handoff: this binding reaches _orHookInformLibrary (orLibrary then drops its own `replace main`/[Main] under a Beguile compile), so pull pkgOrHooks for the #startup that wires __orBeguileMainInit into bglInit. #once-guarded; harmless if pulled more than once.
#include "pkgOrHooks"
// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orPlayerCommandQueue";
// The player's command queue (an orActionQueue). Enqueue commands with pushCommand (appends to the
// back) or preempt the current turn with preemptCommand (runs next). Query/clear the queue as needed.
extern object playerCommands{
    void pushCommand(string cmd, bool isMeta = false, bool isSilent = false);      // append to the queue
    void preemptCommand(string cmd, bool isMeta = false, bool isSilent = false);   // run before anything queued
    int  getLength();                                                              // number of queued commands
    void clear();                                                                  // empty the queue
}

// Queue `cmd` as a preempting command and mark the current turn meta; returns true (handled).
// Used by room direction/look routines: `bool s_look() { return redirectCommand("x jeep"); }`.
extern bool redirectCommand(string cmd);

// Turn-inference message suppression flag (orPlayerCommandQueue.h `Constant noInferMessage 1`).
extern const int noInferMessage;