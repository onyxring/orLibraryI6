//===================================================================================================
// bindings/orStatusLine.bgl — Beguile binding for orLibrary's orStatusLine extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orStatusLine draws a three-region status bar (left / middle / right).
//
// Its author surface is OVERRIDE HOOKS, not callable externs: a game customises the bar by DEFINING
// its own `orStatusLeft` / `orStatusMiddle` / `orStatusRight` routines (each `#ifndef`-guarded in I6,
// so your definition replaces the default). Provide them from an `#i6` island (or via `#i6replace`),
// e.g.  #i6 [ orStatusLeft; print (name) location; ];  — there is nothing to `extern`-declare here,
// which is why this binding carries only the #includeI6.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
// dependency bindings — mirror orStatusLine.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "orString"
#include "orCenter"
#include "orUtilRef"
#include "orUtilUi"
#include "_orHookInformLibrary"   // this extension's I6 brings in _orHookInformLibrary: its play-loop setup must run

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orStatusLine";
