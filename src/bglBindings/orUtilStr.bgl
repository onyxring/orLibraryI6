/* -----------------------------------------------------------------------------
    orUtilStr.bgl - Bindings for orLibrary's orUtilStr extension
    util.orStr: make, compare and print text held as a literal string, a
    character buffer or an orLibrary string.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilRef"
#include "orString"
#include "_orUtil"

/// String helpers, reached as `util.orStr`. A new orLibrary string comes back as a value to print or pass on.
extern class _orStr : object {
    emitter var  new(var unkStr)                                 { ($self.new($unkStr)) }                         /// A new orLibrary string holding the text.
    emitter var  format(var pattern)                            { ($self.format($pattern)) }                      /// A new orLibrary string built from a pattern.
    emitter var  format(var pattern, var p1)                    { ($self.format($pattern, $p1)) }                 /// The same, with one value substituted.
    emitter var  format(var pattern, var p1, var p2)            { ($self.format($pattern, $p1, $p2)) }            /// The same, with two values substituted.
    emitter var  format(var pattern, var p1, var p2, var p3)    { ($self.format($pattern, $p1, $p2, $p3)) }       /// The same, with three values substituted.
    emitter var  trim(var buf)                                  { ($self.trim($buf)) }                            /// A new orLibrary string without the spaces at either end.
    emitter bool areEqual(var buf1, var buf2)                   { ($self.areEqual($buf1, $buf2)) }                /// True when the two texts are the same.
    emitter bool areEqual(var buf1, var buf2, bool caseInsensitive) { ($self.areEqual($buf1, $buf2, $caseInsensitive)) }   /// True when the two texts are the same, ignoring case on request.
    emitter void print(var buf)                                 { $self.print($buf) }                             /// Print the text.
    emitter void print(var buf, property prop)                 { $self.print($buf, $prop) }                       /// Print the text an object's property holds.
}
// Add orStr to the util object
extend class _orUtil {
    ref _orStr orStr;
}

#includeI6 "orUtilStr";
