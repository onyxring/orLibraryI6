//===================================================================================================
// bindings/_orHookKeyboard.bgl — Beguile binding for orLibrary's _orHookKeyboard hook.
//---------------------------------------------------------------------------------------------------
// orLibrary's the command-reading hooks are Beguile's <extensions/stdlib/hooks/keyboard>, which merges them into the
// library rather than replacing its routines; orLibrary's I6 copy is kept out. Every binding whose I6
// brings in _orHookKeyboard includes this file.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/stdlib/hooks/keyboard>

// Ahead of every orLibrary include: a hook whose _STAGE is above the last library stage skips itself.
#emitfirst {
    Constant orHookKeyboard_STAGE 99; #ifdef orHookKeyboard_STAGE; #endif;
}
