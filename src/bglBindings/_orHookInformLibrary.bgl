//===================================================================================================
// bindings/_orHookInformLibrary.bgl — Beguile binding for orLibrary's _orHookInformLibrary hook.
//---------------------------------------------------------------------------------------------------
// orLibrary's play-loop hooks are Beguile's <extensions/stdlib/hooks/informLibrary>, which merges them
// into the library rather than replacing InformLibrary; orLibrary's I6 copy is kept out. Every binding
// whose I6 brings in _orHookInformLibrary includes this file.
//
// It also runs orLibrary's play-loop setup from bglInit: under Beguile the BLR owns `main`, and the
// stdlib Main survives as `_oldmain`, which bglInit runs after the setup.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/stdlib/hooks/informLibrary>

// Ahead of every orLibrary include: a hook whose _STAGE is above the last library stage skips itself.
#emitfirst {
    Constant orHookInformLibrary_STAGE 99; #ifdef orHookInformLibrary_STAGE; #endif;
}

#includeI6 "_orInfExt";                  // orInfExt, which the hooks' users are

// After the library, where orInfExt and LibraryExtensions are defined.
#emitlast {
    [ __orBeguileMainInit;
        #ifdef allocateInformExtensions;
            allocateInformExtensions();
        #endif;
    ];
}

#startup {
    __orBeguileMainInit();
}
