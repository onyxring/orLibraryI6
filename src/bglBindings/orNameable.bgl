/* -----------------------------------------------------------------------------
    orNameable.bgl - Bindings for orLibrary's orNameable extension
    Objects the player can name (NAME ROCK AS PEBBLE); a named object answers
    to its new name too.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"

extern verb Name { }     /// The action of giving an object a name.
extern verb Unname { }   /// The action of taking a given name away.

/// An object the player can name.
extern class orNameable : object {
    int customArticle;   /// The article printed with the given name, or 0 for none.
}

#include "_orHookInformLibrary"
#includeI6 "orNameable";
