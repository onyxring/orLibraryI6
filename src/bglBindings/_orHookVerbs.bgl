//===================================================================================================
// bindings/_orHookVerbs.bgl — Beguile binding for orLibrary's _orHookVerbs hook.
//---------------------------------------------------------------------------------------------------
// orLibrary's the verb hooks are Beguile's <extensions/stdlib/hooks/verbs>, which merges them into the
// library rather than replacing its routines; orLibrary's I6 copy is kept out. Every binding whose I6
// brings in _orHookVerbs includes this file.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/stdlib/hooks/verbs>

// Ahead of every orLibrary include: a hook whose _STAGE is above the last library stage skips itself.
#emitfirst {
    Constant orHookVerbs_STAGE 99; #ifdef orHookVerbs_STAGE; #endif;
}
