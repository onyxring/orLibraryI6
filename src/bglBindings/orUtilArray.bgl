/* -----------------------------------------------------------------------------
    orUtilArray.bgl - Bindings for orLibrary's orUtilArray extension
    util.orArray: read, search and change the values of an object's array property
    or of an untracked array. Positions count from zero.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilNum"
#include "_orUtil"

/// Array helpers, reached as `util.orArray`. Name a property with the `(property)` cast; pass a `rawArray` where a bare array is taken.
extern class _orArray : object {
    //-- An object's array property ------------------------------------
    emitter var  get(object obj, property prop, int n)            { ($self.get($obj, $prop, $n)) }                /// The value at position `n`.
    emitter void set(object obj, property prop, int n, var val)   { $self.set($obj, $prop, $n, $val) }            /// Store `val` at position `n`.
    emitter int  getSize(object obj, property prop)               { ($self.getSize($obj, $prop)) }                /// The number of values the property holds.
    emitter int  getLength(object obj, property prop, var endVal) { ($self.getLength($obj, $prop, $endVal)) }     /// The number of values ahead of the first `endVal`, or the size when there is none.
    emitter int  find(object obj, property prop, var val)         { ($self.find($obj, $prop, $val)) }             /// The position of `val`, or -1.
    emitter void remove(object obj, property prop, int pos)       { $self.remove($obj, $prop, $pos) }             /// Remove the value at `pos` and move the later ones forward.

    //-- An untracked array --------------------------------------------
    emitter var  get(array<var> arr, int n)            { ($self.get($arr, $n)) }                /// The value at position `n`.
    emitter void set(array<var> arr, int n, var val)   { $self.set($arr, $n, $val) }            /// Store `val` at position `n`.
    emitter int  getSize(array<var> arr)               { ($self.getSize($arr)) }                /// The number of values the array holds.
    emitter int  getLength(array<var> arr, var endVal) { ($self.getLength($arr, $endVal)) }     /// The number of values ahead of the first `endVal`, or the size when there is none.
    emitter int  find(array<var> arr, var val)         { ($self.find($arr, $val)) }             /// The position of `val`, or -1.
    emitter void remove(array<var> arr, int pos)       { $self.remove($arr, $pos) }             /// Remove the value at `pos` and move the later ones forward.
}
// Add orArray to the util object
extend class _orUtil {
    ref _orArray orArray;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilArray";
