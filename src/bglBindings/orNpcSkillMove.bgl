/* -----------------------------------------------------------------------------
    orNpcSkillMove.bgl - Bindings for orLibrary's orNpcSkillMove extension
    A skill that moves a character: along a path, after a target, or at random.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orNpc"
#include "orUtilRef"
#include "orUtilMapPathFinder"

//-- Constants -------------------------------------------
extern const int MOVE_PATTERN_REVERSE;   /// At the end of the path, walk back along it.
extern const int MOVE_PATTERN_REPEAT;    /// At the end of the path, start again from the beginning.
extern const int MOVE_PATTERN_SINGLE;    /// Walk the path once, then stop.
extern const int MOVE_PATTERN_HALT;      /// Don't move.

//-- Properties ------------------------------------------
extern property movePath;          /// The rooms to visit, in order.
extern property moveArrived;       /// A routine called when a room on the path is reached.
extern property followTarget;      /// An object to move toward when it is in an adjacent room.
extern property moveTargetFound;   /// A routine called when a followed target is caught up with.

//-- Classes ---------------------------------------------
/// The move skill.
extern class orNpcSkillMove : object {
    int        movePattern;      /// One of the `MOVE_PATTERN_` constants; `MOVE_PATTERN_REVERSE` by default.
    ref object lastLocation;     /// The room the character was in before its last move.
    bool       moveDoesWander;   /// True (the default) to wander at random when there is no path or target.
    emitter void moveInDirection(object dir) { $self.moveInDirection($dir) }   /// Move the character one step in a compass direction.
}

#include "_orHookInformLibrary"
#includeI6 "orNpcSkillMove";
