/* -----------------------------------------------------------------------------
    orDialogue.bgl - Bindings for orLibrary's orDialogue extension
    Conversation by ASK, TELL and SAY. A topic is an object the player names, with a
    reply and the characters it belongs to; topics under a parent share its characters.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orStylePrintRules"
#include "orUtilArray"
#include "orUtilRef"
#include "_orInfExt"

//-- Classes ------------------------------------------
/// A topic of conversation.
extern class orTopic : object {
    string                   short_name;    /// Its printed name.
    ref object               knownBy;       /// Who can be asked about it; taken from its parent when unset.
    ref object               context;       /// Who it can be said or told to; taken from its parent when unset.
    string                   quip;          /// The reply: a string, or a `bool quip()` routine.
    rawArray<dictionaryWord> name;          /// The words the player can call it.
    rawArray<dictionaryWord> adjective;     /// The words that are adjectives for it.
    bool                     requireNoun;   /// True when an adjective alone must not match it.
    emitter bool hasBeenTold() { ($self.hasBeenTold()) }   /// True once the topic has been told.
}

//-- Actions ------------------------------------------
extern verb talk { }                     /// Talking to someone.
extern verb askTopic { }                 /// Asking someone about a topic.
extern verb tellTopic { }                /// Telling someone about a topic.
extern verb sayTopic { }                 /// Saying a topic to someone.
extern verb unrecognizedTopicWords { }   /// Speaking words that match no topic.
extern verb kissNoun { }                 /// Kissing a character.
extern verb vagueTalk { }                /// Talking with no topic recognized.
extern verb reviewObj { }                /// Printing an object's description again.

//-- Routines ------------------------------------------
extern bool isDialogueAction(var act);   /// True when `act` is one of the conversation actions.

#include "_orHookInformLibrary"
#include "_orHookParser"
#includeI6 "orDialogue";
