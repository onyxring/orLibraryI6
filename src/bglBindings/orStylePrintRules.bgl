/* -----------------------------------------------------------------------------
    orStylePrintRules.bgl - Bindings for orLibrary's orStylePrintRules extension
    Print a string or an object's name in a text style, then return to plain text.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"

extern void italics(var o);     /// Print a string or an object's name in italics.
extern void strong(var o);      /// Print a string or an object's name in bold.
extern void highlight(var o);   /// Print a string or an object's name in reverse video.

#includeI6 "orStylePrintRules";
