//===================================================================================================
// bindings/_orHookStandardLibrary.bgl — Beguile binding for orLibrary's _orHookStandardLibrary hook.
//---------------------------------------------------------------------------------------------------
// orLibrary's the hooks across the parser's routines are Beguile's <extensions/stdlib/hooks/standardLibrary>, which merges them into the
// library rather than replacing its routines; orLibrary's I6 copy is kept out. Every binding whose I6
// brings in _orHookStandardLibrary includes this file.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/stdlib/hooks/standardLibrary>

// Ahead of every orLibrary include: a hook whose _STAGE is above the last library stage skips itself.
#emitfirst {
    Constant orHookStandardLibrary_STAGE 99; #ifdef orHookStandardLibrary_STAGE; #endif;
}
