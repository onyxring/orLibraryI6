//===================================================================================================
// bindings/orCenter.bgl — Beguile binding for orLibrary's orCenter extension.
//---------------------------------------------------------------------------------------------------
// Beguile's center extension replaces orCenter.h: orCenter and orInset forward to bgl.output.center() and
// bgl.output.inset(), so orLibrary's I6 callers (orMenu, orStatusLine, orTransition) print through it, and orCenter.h,
// seeing center_bgl, leaves out its routines and its 8000-byte buffer.
//
//     orCenter("*** You have won! ***^(Good job!)");
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/general/center>

// center_bgl leaves orCenter.h's routines out; the HIGHLIGHT_* constants are for its I6 callers.
#i6 {
    Constant center_bgl;            #ifdef center_bgl; #endif;
    Constant NO_HIGHLIGHT 0;        #ifdef NO_HIGHLIGHT; #endif;
    Constant HIGHLIGHT_TEXT_ONLY 1; #ifdef HIGHLIGHT_TEXT_ONLY; #endif;
    Constant HIGHLIGHT_ALL 2;       #ifdef HIGHLIGHT_ALL; #endif;
}

/// Print `text` centered; see bgl.output.center().
void orCenter(var text, int maxwidth = 0, int highlightMode = 0, bool leftAlign = false,
              func<int, int> prefixPostFixCallback = null, int subIndent = 0) {
    bgl.output.center(text, maxwidth, (centerHighlight)highlightMode, leftAlign, prefixPostFixCallback, subIndent);
}

/// Print `text` between margins of `margin` columns; see bgl.output.inset().
void orInset(var text, int margin = 0, int subIndent = 0) {
    bgl.output.inset(text, margin, subIndent);
}
