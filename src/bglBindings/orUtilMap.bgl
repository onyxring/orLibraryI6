/* -----------------------------------------------------------------------------
    orUtilMap.bgl - Bindings for orLibrary's orUtilMap extension
    util.orMap: opposite directions, and simple questions about the map.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilRef"
#include "_orUtil"

/// Map and direction helpers, reached as `util.orMap`.
extern class _orMap : object {
    emitter property reverseDirProp(property d)                       { ($self.reverseDirProp($d)) }   /// The opposite direction property: `s_to` for `n_to`.
    emitter object   reverseDirObj(object d)                          { ($self.reverseDirObj($d)) }    /// The opposite compass object: `s_obj` for `n_obj`.
    /// The compass object that leads from `start` to the room next to it, or 0 when the rooms don't adjoin.
    emitter object   getDirectionToAdjacentObject(object start, object adjacentRoom) { ($self.getDirectionToAdjacentObject($start, $adjacentRoom)) }
    emitter object   locationOf(object a)                            { ($self.locationOf($a)) }        /// The room an object or character is in.
}
// Add orMap to the util object
extend class _orUtil {
    ref _orMap orMap;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilMap";
