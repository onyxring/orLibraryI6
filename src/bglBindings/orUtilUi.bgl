/* -----------------------------------------------------------------------------
    orUtilUi.bgl - Bindings for orLibrary's orUtilUi extension
    util.orUi: window sizes, the window being printed to, the cursor and
    keypresses, alike on the Z-machine and Glulx.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "_orUtil"

/// Display helpers, reached as `util.orUi`. Sizes are in characters and rows.
extern class _orUI : object {
    emitter int  getStatusWidth()              { ($self.getStatusWidth()) }       /// The width of the status window.
    emitter int  getScreenWidth(var win = 0)   { ($self.getScreenWidth($win)) }   /// The width of a window; the status window when none is given.
    emitter int  getScreenHeight()             { ($self.getScreenHeight()) }      /// The height of the screen.
    emitter int  getStatusHeight()             { ($self.getStatusHeight()) }      /// The height of the status window.
    emitter void setStatusHeight(int h)        { $self.setStatusHeight($h) }      /// Set the height of the status window.
    emitter void activateMain()                { $self.activateMain() }           /// Print to the main window from now on.
    emitter void activateStatus()              { $self.activateStatus() }         /// Print to the status window from now on.
    emitter void activateWindow(var win)       { $self.activateWindow($win) }     /// Print to the given window from now on.
    emitter int  getChar()                     { ($self.getChar()) }              /// Wait for a keypress and give its character code.
    emitter void eraseWindow(var win)          { $self.eraseWindow($win) }        /// Clear the given window.
    emitter void eraseMain()                   { $self.eraseMain() }              /// Clear the main window.
    emitter void eraseStatus()                 { $self.eraseStatus() }            /// Clear the status window.
    emitter void eraseScreen()                 { $self.eraseScreen() }            /// Clear the whole screen.
    emitter void position(int x, int y)            { $self.position($x, $y) }           /// Move the cursor to column `x`, row `y` of the status window, counting from 0.
    emitter void position(int x, int y, var win)   { $self.position($x, $y, $win) }     /// Move the cursor to column `x`, row `y` of a window, counting from 0.
    emitter void hideCursor()                  { $self.hideCursor() }             /// Park the cursor at the far corner of the status window.
    emitter void pauseForInput()               { $self.pauseForInput() }          /// Hide the cursor and wait for a keypress.
}
// Add orUi to the util object
extend class _orUtil {
    ref _orUI orUi;
}

#includeI6 "orUtilUi";
