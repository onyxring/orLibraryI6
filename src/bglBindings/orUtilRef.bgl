/* -----------------------------------------------------------------------------
    orUtilRef.bgl - Bindings for orLibrary's orUtilRef extension
    util.orRef: tell what kind of thing a value is, and read or print a property
    that may hold a value or a routine.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilNum"
#include "_orUtil"

/// Value helpers, reached as `util.orRef`. Name a property with the `(property)` cast.
extern class _orRef : object {
    emitter bool isRoutine(var r)        { ($self.isRoutine($r)) }          /// True when the value is a routine.
    emitter bool isString(var r)         { ($self.isString($r)) }           /// True when the value is a string.
    emitter bool isObject(var r)         { ($self.isObject($r)) }           /// True when the value is an object.
    emitter bool isDictionaryWord(var j) { ($self.isDictionaryWord($j)) }   /// True when the value is a dictionary word; reliable on Glulx only.

    emitter var resolveValue(var obj, property prop)                     { ($self.resolveValue($obj, $prop)) }             /// The property's value, running it when it is a routine; `obj` itself when it lacks the property.
    emitter var resolveValue(var obj, property prop, var p1)             { ($self.resolveValue($obj, $prop, $p1)) }        /// The same, passing one argument to a routine.
    emitter var resolveValue(var obj, property prop, var p1, var p2)     { ($self.resolveValue($obj, $prop, $p1, $p2)) }   /// The same, passing two arguments to a routine.

    emitter bool resolvePrint(var obj, property prop)                    { ($self.resolvePrint($obj, $prop)) }             /// Print the property's value, running it when it is a routine; true once something printed.
    emitter bool resolvePrint(var obj, property prop, var p1)            { ($self.resolvePrint($obj, $prop, $p1)) }        /// The same, passing one argument to a routine.
}
// Add orRef to the util object
extend class _orUtil {
    ref _orRef orRef;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilRef";
