/* -----------------------------------------------------------------------------
    orStateDescriptors.bgl - Bindings for orLibrary's orStateDescriptors extension
    Notes after an object's name in room descriptions and inventories, such as
    (closed) or (worn). A game adds its own with handler routines:
        bool onBack(object obj, bool suppress) { … }
        orStateDescriptors.addInventoryHandler(onBack);

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"

/// The type of `orStateDescriptors`. A handler returns true when it has a note for `obj`, and prints it unless `suppress` is true.
extern class orRoutineList : object {
    /// Add a handler for room descriptions.
    emitter void addRoomDescriptionHandler(func<bool, object, bool> handler)    { $self.addRoomDescriptionHandler($handler) }
    /// Add a handler for inventories.
    emitter void addInventoryHandler(func<bool, object, bool> handler)          { $self.addInventoryHandler($handler) }
    /// Remove a handler for room descriptions.
    emitter void removeRoomDescriptionHandler(func<bool, object, bool> handler) { $self.removeRoomDescriptionHandler($handler) }
    /// Remove a handler for inventories.
    emitter void removeInventoryHandler(func<bool, object, bool> handler)       { $self.removeInventoryHandler($handler) }
    int suppressSingleItemWhich;   /// Set to 1 to leave out "which is" when only one item is listed.
}
extern orRoutineList orStateDescriptors;   /// The list of state-note handlers.

#include "_orHookInformLibrary"
#include "_orHookWriteAfterEntry"
#includeI6 "orStateDescriptors";
