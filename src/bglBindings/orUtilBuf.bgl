/* -----------------------------------------------------------------------------
    orUtilBuf.bgl - Bindings for orLibrary's orUtilBuf extension
    util.orBuf: measure, compare, search and edit orLibrary's character buffers.
    A source argument can be a literal string, a buffer or an orLibrary string.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilNum"
#include "orUtilChar"
#include "_orUtil"

/// Character-buffer helpers, reached as `util.orBuf`.
extern class _orBuf : object {
    //-- Fill, measure and print ---------------------------------------
    emitter void setFromLiteral(var buf, var stringVal)          { $self.setFromLiteral($buf, $stringVal) }   /// Fill the buffer with a literal string's text.
    emitter void setFromBuffer(var buf, var source)              { $self.setFromBuffer($buf, $source) }       /// Fill the buffer with another buffer's text.
    emitter int  getLength(var buf)                              { ($self.getLength($buf)) }                  /// The number of characters in the text.
    emitter void setLength(var buf, int newLength)               { $self.setLength($buf, $newLength) }        /// Set the number of characters in the text.
    emitter int  getSize(var buf)                                { ($self.getSize($buf)) }                    /// The number of characters the buffer can hold, or -1 when it records no size.
    emitter bool isSized(var buf)                                { ($self.isSized($buf)) }                    /// True when the buffer records its own size.
    emitter void print(var buf)                                  { $self.print($buf) }                        /// Print the text.
    emitter void print(var buf, int len)                         { $self.print($buf, $len) }                  /// Print the first `len` characters.

    //-- Single characters ---------------------------------------------
    emitter char getChar(var buf, int pos)                       { ($self.getChar($buf, $pos)) }              /// The character at `pos`.
    emitter void setChar(var buf, int pos, char val)             { $self.setChar($buf, $pos, $val) }          /// Store a character at `pos`.

    //-- Compare and search --------------------------------------------
    emitter bool equals(var buf1, var buf2)                      { ($self.equals($buf1, $buf2)) }             /// True when the two texts are the same.
    emitter bool equals(var buf1, var buf2, bool caseInsensitive){ ($self.equals($buf1, $buf2, $caseInsensitive)) }   /// True when the two texts are the same, ignoring case on request.
    emitter bool startsWith(var buf1, var buf2)                  { ($self.startsWith($buf1, $buf2)) }         /// True when the first text begins with the second.
    emitter bool startsWith(var buf1, var buf2, bool caseInsensitive) { ($self.startsWith($buf1, $buf2, $caseInsensitive)) }   /// True when the first text begins with the second, ignoring case on request.
    emitter bool endsWith(var buf1, var buf2)                    { ($self.endsWith($buf1, $buf2)) }           /// True when the first text ends with the second.
    emitter bool endsWith(var buf1, var buf2, bool caseInsensitive)   { ($self.endsWith($buf1, $buf2, $caseInsensitive)) }   /// True when the first text ends with the second, ignoring case on request.
    emitter int  indexOf(var buf, var searchText)               { ($self.indexOf($buf, $searchText)) }       /// The position of `searchText`, or -1.
    emitter int  indexOf(var buf, var searchText, int startingIndex) { ($self.indexOf($buf, $searchText, $startingIndex)) }   /// The position of `searchText` at or after `startingIndex`, or -1.

    //-- Copy into another buffer --------------------------------------
    emitter void copy(var toBuf, var fromBuf, int numCharsToCopy) { $self.copy($toBuf, $fromBuf, $numCharsToCopy) }   /// Copy characters from one buffer to another.
    emitter void mid(var toBuf, var fromBuf, int fromPos, int numCharsToCopy) { $self.mid($toBuf, $fromBuf, $fromPos, $numCharsToCopy) }   /// Copy characters starting at `fromPos`.
    emitter void left(var toBuf, var fromBuf, int numCharsToCopy)  { $self.left($toBuf, $fromBuf, $numCharsToCopy) }   /// Copy the first characters.
    emitter void right(var toBuf, var fromBuf, int numCharsToCopy) { $self.right($toBuf, $fromBuf, $numCharsToCopy) }  /// Copy the last characters.

    //-- Edit in place -------------------------------------------------
    emitter void insert(var toBuf, var fromBuf, int toPos)       { $self.insert($toBuf, $fromBuf, $toPos) }   /// Insert text at `toPos`.
    emitter void prepend(var toBuf, var fromBuf)                 { $self.prepend($toBuf, $fromBuf) }          /// Add text at the start.
    emitter void append(var toBuf, var fromBuf)                  { $self.append($toBuf, $fromBuf) }           /// Add text at the end.
    emitter void delete(var buf, int pos, int count)            { $self.delete($buf, $pos, $count) }         /// Remove `count` characters starting at `pos`.
    emitter void replace(var buf, var searchText, var replaceText)    { $self.replace($buf, $searchText, $replaceText) }      /// Replace the first `searchText` with `replaceText`.
    emitter void replaceAll(var buf, var searchText, var replaceText) { $self.replaceAll($buf, $searchText, $replaceText) }   /// Replace every `searchText` with `replaceText`.

    //-- Change the whole text -----------------------------------------
    emitter void toUpper(var buf)   { $self.toUpper($buf) }     /// Make every letter upper case.
    emitter void toLower(var buf)   { $self.toLower($buf) }     /// Make every letter lower case.
    emitter void reverse(var buf)   { $self.reverse($buf) }     /// Reverse the order of the characters.
    emitter void trimLeft(var buf)  { $self.trimLeft($buf) }    /// Remove spaces from the start.
    emitter void trimRight(var buf) { $self.trimRight($buf) }   /// Remove spaces from the end.
    emitter void trim(var buf)      { $self.trim($buf) }        /// Remove spaces from both ends.
}
// Add orBuf to the util object
extend class _orUtil {
    ref _orBuf orBuf;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilBuf";
