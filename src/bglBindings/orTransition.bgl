#once
#include "_orHookBanner"
#include "orCenter"
#include "orUtilUi"
#include "_orHookInformLibrary"
#includeI6 "orTransition";

/// Print the centered `text` and `prompt` (by default "Press any key to continue"), wait for a key, then clear the main window unless `skipErase` is true.
extern void orTransition(string text = 0, string prompt = 0, bool skipErase = false);
