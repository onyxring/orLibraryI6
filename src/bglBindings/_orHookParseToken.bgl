/* -----------------------------------------------------------------------------
    _orHookParseToken.bgl - Bindings for orLibrary's _orHookParseToken hook
    Lets orLibrary's extensions replace the steps the parser takes to read one token.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"

#mergeI6 "orHookParseToken"

// Keep orLibrary's own copy of the hook out and declare the globals its users share
#emitfirst {
    Constant orHookParseToken_STAGE 99;      #ifdef orHookParseToken_STAGE; #endif;
    Global pt_return;       ! 0: continue on, true: return the return value, -1: jump to FailToken,
                            ! -2: jump to ObjectList, -3: jump to TryAgain
    Global pt_many_flag;
}
