!% +include_path=<standard library folder>,<orlibrary folder>,<unitTests folder>
!% -E1								!--Microsoft Style Error Msgs, needed so VisualStudio and IFIDE can jump to error
!% -d 								!--convert double spaces after periods to single space
!% $ZCODE_FILE_END_PADDING=0 		!--eliminate extra padding; so the output size is more precise
!% $OMIT_UNUSED_ROUTINES=1
!---------------------------------------------------------------------------------------------------
! unitTestRunner.inf
! The runner for orLibrary unit/regression tests. 
!
! Not all extensions will have unit tests.  For example, UI-centric extension, such as orMenu and
!   orUtilUI don't lend themselves well to this form of testing.
!
! Other extensions could use unit tests, but don't have them at this time.  Several, such as 
!   orString, have unit test modules with minimal actual tests.  
!
! This collection of tests cases will grow over time as bugs are identified.
! 
!---------------------------------------------------------------------------------------------------
! Created by Jim Fisher
!---------------------------------------------------------------------------------------------------
! 2025.12.15	Initial revision
!---------------------------------------------------------------------------------------------------
Constant Story				"orLibrary Unit Test Runner";
Constant orUnitTestAutoRun true;
!---------------------------------------------------------------------------------------------------
! Include unit tests here...

