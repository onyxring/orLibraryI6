/* -----------------------------------------------------------------------------
    orUtilParser.bgl - Bindings for orLibrary's orUtilParser extension
    The values a chooseobject rule receives and returns, and util.orParser,
    which changes the list of objects the parser is choosing between.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilNum"
#include "_orUtil"

//-- What the parser is asking a chooseobject rule ----------------------
extern const int PLANNING_EXCLUDE;   /// The parser means to leave the object out of an "all".
extern const int PLANNING_INCLUDE;   /// The parser means to include the object in an "all".
extern const int ASKING_FOR_HINT;    /// The parser wants help choosing between objects.

//-- What a chooseobject rule answers -----------------------------------
extern const int DEFER_CHOICE;       /// Leave the choice to other rules, then to the parser.
extern const int FORCE_INCLUDE;      /// Include the object.
extern const int FORCE_EXCLUDE;      /// Leave the object out.

/// Parser helpers, reached as `util.orParser`.
extern class _orParser : object {
    emitter int excludeObjFromDisambiguation(object obj) { ($self.excludeObjFromDisambiguation($obj)) }   /// Drop an object from the choices, keeping the list's length.
    emitter void removeMatchPos(int pos) { ($self.removeMatchPos($pos)) }                                 /// Remove the choice at `pos`, shortening the list.
}
// Add orParser to the util object
extend class _orUtil {
    ref _orParser orParser;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilParser";
