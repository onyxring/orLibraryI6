//===================================================================================================
// bindings/orReferByContents.bgl — Beguile binding for orLibrary's orReferByContents extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orReferByContents lets a container be referred to by the words of the things
// inside it (e.g. "TAKE WATER" when a glass of water is what's actually held). Subclass it and tune
// which actions this applies to.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
// dependency bindings — mirror orReferByContents.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "orUtilParser"

// Base class for a container whose contents lend it their names. `referActions` lists the actions the
// content-referencing applies to (defaults to take/drop/insert); `ignoreActions` lists actions to
// exclude. Each is a list of action references (e.g. {take, drop, insert}).
extern class orReferByContents : object {
    array<var> referActions;
    array<var> ignoreActions;
}

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orReferByContents";
