/* -----------------------------------------------------------------------------
    orDialogueMenu.bgl - Bindings for orLibrary's orDialogueMenu extension
    Lists the topics the player can raise as a menu, shown before each prompt if wanted.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "orUtilArray"
#include "_orTopicPool"
#include "orMenu"
#include "orPlayerCommandQueue"
#include "orUtilBuf"

extern bool autoMenuSpeak;   /// True, the default, to show the menu before each prompt while there are topics to raise.

extern property commandText;   /// A topic's command, queued when it is chosen: a string, or a routine that prints it.
extend class orTopic {
    string commandText;   /// The command queued when the topic is chosen; it must be one the parser understands.
    string menuDisplay;   /// The topic's text in the menu; its `short_name` unless set.
}

/// The type of the dialogue menu.
extern class _orDialogueMenu : orMenu {
    emitter int  initForDisplay()   { ($self.initForDisplay()) }   /// Refill the menu with the topics the player can raise now; returns the count.
    emitter void clear()            { $self.clear() }              /// Empty the menu.
    emitter void add(object topic)  { $self.add($topic) }          /// Add a topic to the menu.
}
extern _orDialogueMenu orDialogueMenu;   /// The dialogue menu.

#include "_orHookKeyboard"
#include "_orHookParser"
#include "_orHookVerbs"
#includeI6 "orDialogueMenu";
