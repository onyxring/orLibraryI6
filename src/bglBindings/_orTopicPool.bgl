/* -----------------------------------------------------------------------------
    _orTopicPool.bgl - Bindings for orLibrary's topic pools
    Each character keeps a pool of topics to raise next. Telling a topic withdraws it
    and its excluded topics, and adds its related ones, so topics can lead to one another.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orDialogue"
#include "orUtilArray"
#include "_orInfExt"

extern const int allTopics;   /// In `excludedTopics`: withdraws every topic in the teller's pool.

extend class orTopic {
    rawArray<object> relatedTopics;    /// Topics added to the pools once this one is told.
    rawArray<var>    excludedTopics;   /// Topics, or `allTopics`, withdrawn once this one is told.
}

extern void playerTakeNoticeOfTopic(object topic);   /// Put a tellable topic at the front of the player's pool, unless it is there already.
