//===================================================================================================
// bindings/orFirstImpressions.bgl — Beguile binding for orLibrary's orFirstImpressions extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orFirstImpressions prints extra text the FIRST time an object (or room) is
// examined — a `preImpression` before its description and a `postImpression` after — then never again.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
// dependency bindings — mirror orFirstImpressions.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively.
#include "_orInfExt"
#include "_orHookInformLibrary"   // this extension's I6 brings in _orHookInformLibrary: its play-loop setup must run

// Shown only on the first examine, before (preImpression) and after (postImpression) the object's own
// description. Each is a string, or a routine that prints. Both honour orPrint markup if it is loaded.
extern property preImpression;
extern property postImpression;

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orFirstImpressions";
