/* -----------------------------------------------------------------------------
    orUtilNum.bgl - Bindings for orLibrary's orUtilNum extension
    util.orNum: unsigned comparisons, ranges, powers, bits, and the least or
    greatest of two or three numbers.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "_orUtil"

/// Number helpers, reached as `util.orNum`. The `u` routines read their numbers as unsigned.
extern class _orNum : object {
    emitter bool uIsGreaterThan(int v1, int v2)          { ($self.uIsGreaterThan($v1, $v2)) }                             /// True when `v1` is above `v2`, unsigned.
    emitter bool uIsGreaterThanOrEqualTo(int v1, int v2) { ($self.uIsGreaterThanOrEqualTo($v1, $v2)) }                    /// True when `v1` is `v2` or above, unsigned.
    emitter bool uIsLessThan(int v1, int v2)             { ($self.uIsLessThan($v1, $v2)) }                                /// True when `v1` is below `v2`, unsigned.
    emitter bool uIsLessThanOrEqualTo(int v1, int v2)    { ($self.uIsLessThanOrEqualTo($v1, $v2)) }                       /// True when `v1` is `v2` or below, unsigned.
    emitter bool isBetween(int v, int v1, int v2)        { ($self.isBetween($v, $v1, $v2)) }                              /// True when `v` lies between the two bounds, given in either order.
    emitter bool uIsBetween(int v, int v1, int v2)       { ($self.uIsBetween($v, $v1, $v2)) }                             /// True when `v` lies between the two bounds, unsigned.
    emitter int  pow(int a, int b)                       { ($self.pow($a, $b)) }                                          /// `a` raised to the power `b`.
    emitter bool getBit(int val, int bit)                { ($self.getBit($val, $bit)) }                                   /// True when the bit is set; bit 0 is the lowest.
    emitter bool isBitSet(int val, int bit)              { ($self.isBitSet($val, $bit)) }                                 /// True when the bit is set; bit 0 is the lowest.
    emitter int  setBitOn(int val, int bit)              { ($self.setBitOn($val, $bit)) }                                 /// The value with the bit set.
    emitter int  setBitOff(int val, int bit)             { ($self.setBitOff($val, $bit)) }                                /// The value with the bit cleared.
    emitter int  xor(int val1, int val2)                 { ($self.xor($val1, $val2)) }                                    /// The bitwise exclusive or.
    emitter int  max(int a, int b)                       { ($self.max($a, $b, orMaxEnd, orMaxEnd, orMaxEnd)) }            /// The greater of two numbers.
    emitter int  max(int a, int b, int c)                { ($self.max($a, $b, $c, orMaxEnd, orMaxEnd)) }                  /// The greatest of three numbers.
    emitter int  min(int a, int b)                       { ($self.min($a, $b, orMinEnd, orMinEnd, orMinEnd)) }            /// The lesser of two numbers.
    emitter int  min(int a, int b, int c)                { ($self.min($a, $b, $c, orMinEnd, orMinEnd)) }                  /// The least of three numbers.
    emitter int  umax(int a, int b)                      { ($self.umax($a, $b, 0, 0, 0)) }                                /// The greater of two numbers, unsigned.
    emitter int  umax(int a, int b, int c)               { ($self.umax($a, $b, $c, 0, 0)) }                               /// The greatest of three numbers, unsigned.
    emitter int  umin(int a, int b)                      { ($self.umin($a, $b, orUMinEnd, orUMinEnd, orUMinEnd)) }        /// The lesser of two numbers, unsigned.
    emitter int  umin(int a, int b, int c)               { ($self.umin($a, $b, $c, orUMinEnd, orUMinEnd)) }               /// The least of three numbers, unsigned.
    int maxNumber;                                                                                                        /// The largest signed number.
    int uMaxNumber;                                                                                                       /// The largest unsigned number.
}
// Add orNum to the util object
extend class _orUtil {
    ref _orNum orNum;
}

#include "_orHookInformLibrary"
#includeI6 "orUtilNum";
