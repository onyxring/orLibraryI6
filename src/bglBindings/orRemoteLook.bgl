/* -----------------------------------------------------------------------------
    orRemoteLook.bgl - Bindings for orLibrary's orRemoteLook extension
    LOOK in a direction: a room says what is seen each way, and how it looks
    from the room next door.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilMap"

extern verb LookDirection { }   /// The action of looking in a direction.

//-- Properties ------------------------------------------
extern property n_look;     /// What is seen looking north from this room: a string or a routine.
extern property s_look;     /// What is seen looking south.
extern property e_look;     /// What is seen looking east.
extern property w_look;     /// What is seen looking west.
extern property ne_look;    /// What is seen looking northeast.
extern property nw_look;    /// What is seen looking northwest.
extern property se_look;    /// What is seen looking southeast.
extern property sw_look;    /// What is seen looking southwest.
extern property u_look;     /// What is seen looking up.
extern property d_look;     /// What is seen looking down.
extern property in_look;    /// What is seen looking in.
extern property out_look;   /// What is seen looking out.

extern property remoteDescription;   /// How a room looks from an adjacent room: a string or a routine.
extern property remoteClosed;        /// On a door, shown when the player looks its way while it is closed: a string or a routine.
extern property cant_look;           /// Shown when there is nothing to see in a compass direction: a string or a routine.
extern property cant_look_alt;       /// Shown when there is nothing to see up, down, in or out: a string or a routine.

#include "_orHookInformLibrary"
#includeI6 "orRemoteLook";
