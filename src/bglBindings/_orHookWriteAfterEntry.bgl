//===================================================================================================
// bindings/_orHookWriteAfterEntry.bgl — Beguile binding for orLibrary's _orHookWriteAfterEntry hook.
//---------------------------------------------------------------------------------------------------
// orLibrary's the list-entry hooks are Beguile's <extensions/stdlib/hooks/writeAfterEntry>, which merges them into the
// library rather than replacing its routines; orLibrary's I6 copy is kept out. Every binding whose I6
// brings in _orHookWriteAfterEntry includes this file.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include <extensions/stdlib/hooks/writeAfterEntry>

// Ahead of every orLibrary include: a hook whose _STAGE is above the last library stage skips itself.
#emitfirst {
    Constant orHookWriteAfterEntry_STAGE 99; #ifdef orHookWriteAfterEntry_STAGE; #endif;
}
