/* -----------------------------------------------------------------------------
    orUtilMapPathFinder.bgl - Bindings for orLibrary's orUtilMapPathFinder extension
    util.orMap.pathFinder: the shortest route between two rooms of the map.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilMap"

/// The route finder, reached as `util.orMap.pathFinder`.
extern class _orPathFinder : object {
    /// Find the shortest route from a character or room to `endRoom` and keep it in `path`. Gives the first room to move to, 0 when already there, -1 when it can't be reached, -2 when the route is too long.
    emitter var  determinePath(object npcOrRoom, object endRoom) { ($self.determinePath($npcOrRoom, $endRoom)) }
    emitter void convertPathToDirections(object startingLoc)     { $self.convertPathToDirections($startingLoc) }   /// Turn each room of `path` into the compass object that leads to it, setting out from `startingLoc`.
    emitter int  getPathLength()                                 { ($self.getPathLength()) }                       /// The number of steps in `path`.
    array<object> path;                                                                                            /// The route found: rooms, or compass objects once converted. Read it with `util.orArray`.
}
// Add pathFinder to the map helpers
extend class _orMap {
    ref _orPathFinder pathFinder;
}

extern const int PATHDEPTH;   /// The longest route the finder considers.

#include "_orHookInformLibrary"
#includeI6 "orUtilMapPathFinder";
