//===================================================================================================
// bindings/orBetterChoice.bgl — Beguile binding for orLibrary's orBetterChoice extension.
//---------------------------------------------------------------------------------------------------
// Including this binding pulls in the I6 extension (#includeI6 below), so a game can depend on the
// Beguile binding alone. orBetterChoice improves parser disambiguation; an object can influence
// whether it is chosen by providing a `chooseobject` routine that returns one of the FORCE_*/DEFER
// codes (the FORCE_INCLUDE/FORCE_EXCLUDE/DEFER_CHOICE constants come from orUtilParser).
//===================================================================================================
#once
// dependency bindings — mirror orBetterChoice.h's orLibrary #includes so nested extern
// declarations (types, members, properties, globals) are available transitively. (orUtilParser
// declares FORCE_INCLUDE / FORCE_EXCLUDE / DEFER_CHOICE.)
#include "orUtilParser"
#include "_orInfExt"
// Beguile main-handoff: this binding reaches _orHookInformLibrary (orLibrary then drops its own `replace main`/[Main] under a Beguile compile), so pull pkgOrHooks for the #startup that wires __orBeguileMainInit into bglInit. #once-guarded; harmless if pulled more than once.
#include "pkgOrHooks"

// Per-object disambiguation hook: `int chooseobject(int code)` returning FORCE_INCLUDE / FORCE_EXCLUDE
// to force the object in/out of the match, DEFER_CHOICE to fall through to the extension's own logic,
// or FORCE_PARSER to abort the "better" logic entirely and use the standard parser default.
extern property chooseobject;

// chooseobject return value: abandon orBetterChoice's logic and defer to the plain parser default.
extern const int FORCE_PARSER;   // -1

// Pull in the actual orLibrary I6 extension. The beguiler resolves it (via includePaths) to an
// absolute path and expands that into the transpiled .inf; the shared artifact is this .bgl
// binding, not the intermediate I6. (Raw @"..." stays as an escape hatch for verbatim emission.)
#includeI6 "orBetterChoice";
