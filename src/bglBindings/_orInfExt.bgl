/* -----------------------------------------------------------------------------
    _orInfExt.bgl - Bindings for orLibrary's orInfExt class
    A library extension object that registers itself: declare one and give it the
    ext_ routines it answers.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilArray"
#include "_orHookInformLibrary"

/// A library extension that registers itself; its ext_ routines run with the library's own.
extern class orInfExt : object {
    int priority;   /// Its place among the extensions when they are sorted; 10 unless set.
}
