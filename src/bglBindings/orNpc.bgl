/* -----------------------------------------------------------------------------
    orNpc.bgl - Bindings for orLibrary's orNpc extension
    Characters driven by skills: each turn a character performs the
    highest-priority skill that applies.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilArray"
#include "orUtilRef"

//-- Properties ------------------------------------------
extern property npcInit;   /// A routine on a character, run once at the start of the game.

//-- Classes ---------------------------------------------
/// A character that acts each turn through the skills it has learned.
extern class orNpc : object {
    bool isEnabled;   /// True while the character takes turns.
    int  priority;    /// Turn order: a higher-priority character acts first.
    var  doNothing;   /// A string or routine shown when the character does nothing.
    int  npcId;       /// The character's assigned id.

    emitter void   learnSkill(object skill)     { $self.learnSkill($skill) }         /// Add a skill the character can perform.
    emitter object selectAction()               { ($self.selectAction()) }           /// The highest-priority skill that applies now, or nothing.
    emitter int    getSkillPriority(object skl) { ($self.getSkillPriority($skl)) }   /// The priority the character gives a skill; the skill's `defaultPriority` unless replaced.
    emitter void   heartbeat()                  { $self.heartbeat() }                /// Run one turn of the character's behavior.
}

/// Something a character can do. A skill provides `bool appliesToCharacter(object npc)` and `void perform(object npc)`.
extern class orNpcSkill : object {
    int defaultPriority;   /// The priority used when several skills compete.
    var canPerform;        /// True, or a routine that is true when the skill can run now.
}

//-- Objects ---------------------------------------------
/// The controller of every character.
extern object orNpcControl {
    bool   areEnabled;        /// The master switch for all character activity.
    object getById(int id);   /// The character with the given `npcId`, or nothing.
}

#include "_orHookInformLibrary"
#includeI6 "orNpc";
