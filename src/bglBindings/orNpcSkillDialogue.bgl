/* -----------------------------------------------------------------------------
    orNpcSkillDialogue.bgl - Bindings for orLibrary's orNpcSkillDialogue extension
    A skill that lets a character raise conversation topics of its own.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orNpc"
#include "orDialogue"

extern bool orDialogueAutoAnswer;   /// False (the default) to hold a topic a character raises as a pending question; true to answer it at once.

/// The dialogue skill: a character raises the topics in its `dialoguePool`.
extern class orNPCSkillDialogue : object {
    array<object> dialoguePool;      /// The topics the character can bring up.
    ref object    pendingQuestion;   /// A topic waiting for the player's answer.
    emitter void learnTopic(object topic)        { $self.learnTopic($topic) }          /// Make the character know `topic`.
    emitter void takeNoticeOfTopic(object topic) { $self.takeNoticeOfTopic($topic) }   /// Move `topic` to the front of the pool, to be raised next.
}

#include "_orHookParser"
#includeI6 "orNpcSkillDialogue";
