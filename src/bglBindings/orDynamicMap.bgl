/* -----------------------------------------------------------------------------
    orDynamicMap.bgl - Bindings for orLibrary's orDynamicMap extension
    A map that links its rooms together as the player explores, so each new
    direction taken leads to the next room in a list.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilMap"

//-- Constants -------------------------------------------
extern const int ALLOW_UNIDIRECTIONAL_PATH;   /// For `handleAllocatedReturn`: make a one-way link and leave the way back alone.
extern const int OVERWRITE_RETURN_PATH;       /// For `handleAllocatedReturn`: replace the link already on the way back.
extern const int DISALLOW;                    /// For `handleAllocatedReturn`: refuse the move and make no link.

//-- Classes ---------------------------------------------
/// A lit room with every exit left open for an `orDynamicMap` to fill in.
extern class orDynamicMapRoom : object {
    string cant_go;   /// The message for a blocked direction; the map's own is used when this is unset.
}

/// A map that unfolds during play: each new direction taken links the next room in `found_in`.
extern class orDynamicMap : object {
    rawArray<object> found_in;                /// The rooms to link, in the order they unfold; the first is where play starts.
    string           cant_go;                 /// The blocked-direction message given to the linked rooms.
    bool             complete;                /// True once every room in `found_in` has been linked.
    int              handleAllocatedReturn;   /// What to do when the way back from a new link is already taken.
}

#include "_orHookInformLibrary"
#includeI6 "orDynamicMap";
