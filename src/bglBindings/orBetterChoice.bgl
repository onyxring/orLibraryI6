/* -----------------------------------------------------------------------------
    orBetterChoice.bgl - Bindings for orLibrary's orBetterChoice extension
    Better guesses when the player's words fit several objects. An object can steer
    the choice with a `chooseobject` routine.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilParser"
#include "_orInfExt"

/// An object's routine, `int chooseobject(int code)`, returning `FORCE_INCLUDE`, `FORCE_EXCLUDE`, `DEFER_CHOICE` or `FORCE_PARSER`.
extern property chooseobject;

extern const int FORCE_PARSER;   /// Returned by `chooseobject`: leave the choice to the parser's own default.

#include "_orHookInformLibrary"
#include "_orHookStandardLibrary"
#includeI6 "orBetterChoice";
