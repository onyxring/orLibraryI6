/* -----------------------------------------------------------------------------
    orUtilLoopArray.bgl - Bindings for orLibrary's orUtilLoopArray extension
    util.orLoopArray: step through a list of texts, one each time it is asked.
    Name an object's list with the (property) cast.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orUtil"

/// Cycling lists of text, reached as `util.orLoopArray`.
extern class _orLoopArray : object {
    emitter string getNext(var loopArray)                           { ($self.getNext($loopArray)) }                /// The next entry of a stand-alone list.
    emitter string getNext(object obj, property prop)               { ($self.getNext($obj, $prop)) }               /// The next entry of an object's list.
    emitter string getNext(object obj, property prop, var onceOnly) { ($self.getNext($obj, $prop, $onceOnly)) }    /// The next entry; `onceOnly` says what follows the last one.
    emitter string getAny(object obj, property prop)                { ($self.getAny($obj, $prop)) }                /// An entry not yet used, picked at random.
    emitter bool   isComplete(object obj, property prop)             { ($self.isComplete($obj, $prop)) }           /// True once every entry has been used.
}

// Add orLoopArray to the util object
extend class _orUtil {
     ref _orLoopArray orLoopArray;
}

#include "orUtilArray"

extern const int repeatLast;   /// As `onceOnly`: keep giving the last entry once the list is used up.
