//===================================================================================================
// bindings/pkgOrHooks.bgl — Beguile binding for orLibrary's hooks.
//---------------------------------------------------------------------------------------------------
// Every orLibrary hook, as pkgOrHooks.h has them: each one's binding merges its hooks into the library
// (<extensions/stdlib/hooks/…>) rather than replacing the library's routines. ParseToken__'s split is
// not a hook; orDistinctMeSelf, which needs it, includes _orHookParseToken itself.
//===================================================================================================
#once
#include "_orHookBanner"   // Beguile's banner, with orLibrary's line (every orLibrary binding carries it)
#include "_orHookInformLibrary"
#include "_orHookKeyboard"
#include "_orHookParser"
#include "_orHookStandardLibrary"
#include "_orHookVerbs"
#include "_orHookWriteAfterEntry"
#include "_orHookWriteList"
