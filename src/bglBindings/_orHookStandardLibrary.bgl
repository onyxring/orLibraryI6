/* -----------------------------------------------------------------------------
    _orHookStandardLibrary.bgl - Bindings for orLibrary's _orHookStandardLibrary hook
    Gives orLibrary's extensions their library-wide hooks through Beguile's own hook extension.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include <extensions/stdlib/hooks/standardLibrary>

// Keep orLibrary's own copy of the hook out
#emitfirst {
    Constant orHookStandardLibrary_STAGE 99; #ifdef orHookStandardLibrary_STAGE; #endif;
}
