/* -----------------------------------------------------------------------------
    orPronoun.bgl - Bindings for orLibrary's English pronoun print rules
    Pronouns, possessives and forms of to be that agree with an object, for use
    in print statements and interpolated strings:
        print($"{cThe(actor)} {am(actor)} watching {me(noun)}.");

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"

//-- Pronouns --------------------------------------------
emitter void i(object o)      { print (I)$o; }        /// Print the subject pronoun: I, we, you, they, it, she, he.
emitter void me(object o)     { print (Me)$o; }       /// Print the object pronoun: me, us, you, them, it, her, him.
emitter void my(object o)     { print (My)$o; }       /// Print the possessive adjective: my, our, your, their, its, her, his.
emitter void mine(object o)   { print (Mine)$o; }     /// Print the possessive pronoun: mine, ours, yours, theirs, its, hers, his.
emitter void myself(object o) { print (Myself)$o; }   /// Print the reflexive pronoun: myself, ourselves, itself, herself, himself.

//-- Capitalized pronouns --------------------------------
emitter void cI(object o)      { print (CI)$o; }        /// Print the subject pronoun, capitalized.
emitter void cMe(object o)     { print (CMe)$o; }       /// Print the object pronoun, capitalized.
emitter void cMy(object o)     { print (CMy)$o; }       /// Print the possessive adjective, capitalized.
emitter void cMine(object o)   { print (CMine)$o; }     /// Print the possessive pronoun, capitalized.
emitter void cMyself(object o) { print (CMyself)$o; }   /// Print the reflexive pronoun, capitalized.

//-- Name or pronoun -------------------------------------
emitter void theI(object o)      { print (TheI)$o; }        /// Print "the" and the name, or the subject pronoun for the player.
emitter void theMe(object o)     { print (TheMe)$o; }       /// Print "the" and the name, or the object pronoun for the player.
emitter void theMy(object o)     { print (TheMy)$o; }       /// Print "the" and the name with 's, or the possessive adjective for the player.
emitter void theMine(object o)   { print (TheMine)$o; }     /// Print "the" and the name with 's, or the possessive pronoun for the player.
emitter void theMyself(object o) { print (TheMyself)$o; }   /// Print "the" and the name, or the reflexive pronoun for the player.

//-- Capitalized name or pronoun -------------------------
emitter void cTheI(object o)      { print (CTheI)$o; }        /// Print `theI`, capitalized.
emitter void cTheMe(object o)     { print (CTheMe)$o; }       /// Print `theMe`, capitalized.
emitter void cTheMy(object o)     { print (CTheMy)$o; }       /// Print `theMy`, capitalized.
emitter void cTheMine(object o)   { print (CTheMine)$o; }     /// Print `theMine`, capitalized.
emitter void cTheMyself(object o) { print (CTheMyself)$o; }   /// Print `theMyself`, capitalized.

//-- To be -----------------------------------------------
emitter void am(object o)  { print (Am)$o; }    /// Print the form of to be that agrees with the object and tense: am, is, are, was, were, will.
emitter void cAm(object o) { print (CAm)$o; }   /// Print `am`, capitalized.

//-- Subject with to be ----------------------------------
emitter void iAm(object o)     { print (IAm)$o; }       /// Print the subject pronoun and its form of to be: "I am".
emitter void cIAm(object o)    { print (CIAm)$o; }      /// Print `iAm`, capitalized.
emitter void theIAm(object o)  { print (TheIAm)$o; }    /// Print the name or pronoun and its form of to be: "the guard is".
emitter void cTheIAm(object o) { print (CTheIAm)$o; }   /// Print `theIAm`, capitalized.

#includeI6 "_orPronoun_English";
