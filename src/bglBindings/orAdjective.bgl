/* -----------------------------------------------------------------------------
    orAdjective.bgl - Bindings for orLibrary's orAdjective extension
    An object lists words that are adjectives: they match only beside a noun, unless
    the mode allows a bare adjective to stand for the object.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "orUtilParser"

//-- Constants ------------------------------------------
extern const int REQUIRE_NOUN;   /// A mode: an adjective alone never matches.
extern const int PREFER_NOUN;    /// A mode, the default: a noun is preferred, but a bare adjective can match.

//-- Properties ------------------------------------------
extern property adjective;     /// The words that are adjectives for this object.
extern property requireNoun;   /// A bool, or a routine returning one, that overrides the mode for this object.

//-- Objects ------------------------------------------
/// The extension's settings.
extern object orAdjective {
    int mode;   /// `REQUIRE_NOUN` or `PREFER_NOUN`, for every object.
}

#include "_orHookInformLibrary"
#include "_orHookStandardLibrary"
#includeI6 "orAdjective";
