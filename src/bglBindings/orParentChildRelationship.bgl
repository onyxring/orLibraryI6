/* -----------------------------------------------------------------------------
    orParentChildRelationship.bgl - Bindings for orLibrary's orParentChildRelationship extension
    Relationships beyond in and on (under, behind, …) that the parser, scope
    and room descriptions all understand. Container and supporter are supplied.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "orUtilBuf"

//-- Attributes ------------------------------------------
extern attribute contained;   /// The object is inside its parent.
extern attribute supported;   /// The object is on its parent.

//-- Classes ---------------------------------------------
/// A way one object can hold another: a parent attribute, a child attribute and the prepositions that go with them.
extern class orParentChildRelationship : object {
    var    parentAttribute;            /// The attribute a parent has to offer this relationship.
    var    childAttribute;             /// The attribute given to a child in this relationship.
    string preposition;                /// The preposition, such as "in" or "on".
    string toPreposition;              /// The preposition of putting, such as "into"; `preposition` when unset.
    string fromPreposition;            /// The preposition of removing, such as "out of"; "from" and `preposition` when unset.
    bool   includeContentsInExamine;   /// True (the default) to list a parent's contents when it is examined.

    emitter void sayPrep()       { $self.sayPrep() }        /// Print the preposition.
    emitter void sayToPrep()     { $self.sayToPrep() }      /// Print the preposition of putting.
    emitter void sayFromPrep()   { $self.sayFromPrep() }    /// Print the preposition of removing.
    emitter bool isAppliedTo(object c)          { ($self.isAppliedTo($c)) }   /// True when the child is in this relationship.
    emitter void applyTo(object c)              { $self.applyTo($c) }         /// Put the child in this relationship.
    emitter void removeFrom(object c)           { $self.removeFrom($c) }      /// Take the child out of this relationship.
    emitter bool isProvidedBy(object o)         { ($self.isProvidedBy($o)) }  /// True when the object offers this relationship.
    emitter int  numVisibleChildrenWith(object p) { ($self.numVisibleChildrenWith($p)) }   /// The number of the parent's visible children in this relationship.
}

//-- Objects ---------------------------------------------
extern orParentChildRelationship orPcrContainer;   /// The relationship of being in something.
extern orParentChildRelationship orPcrSupporter;    /// The relationship of being on something.

//-- Routines --------------------------------------------
extern bool   isContained(object c);               /// True when the object is inside its parent.
extern bool   isSupported(object c);               /// True when the object is on its parent.
extern object getPcrFromChild(object c);           /// The relationship the child is in, or nothing.
extern bool   isMissingPcr(object c);              /// True when the child is in no relationship.
extern void   clearAllPcrsFromChild(object c);     /// Take the child out of every relationship.
extern int    numPcrsProvidedBy(object p);         /// The number of relationships the object offers.
extern object getFirstPcrProvidedBy(object p);     /// The first relationship the object offers, or nothing.
extern object inferPcr(object c, object p);        /// The best relationship for putting `c` in or on `p`.

/// Print the contents of `p`, grouped by relationship. `hideDesignatedPcrs` leaves one relationship out; `addInitialLF` starts with a line break.
extern void describeContents(object p, var hideDesignatedPcrs = 0, bool addInitialLF = false);
extern void annotateContents(object p);   /// Print a short parenthetical note of the object's contents.

#include "_orHookInformLibrary"
#include "_orHookParser"
#include "_orHookVerbs"
#include "_orHookWriteAfterEntry"
#includeI6 "orParentChildRelationship";
