/* -----------------------------------------------------------------------------
    _orHookWriteAfterEntry.bgl - Bindings for orLibrary's _orHookWriteAfterEntry hook
    Gives orLibrary's extensions their list-entry hooks through Beguile's own hook extension.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include <extensions/stdlib/hooks/writeAfterEntry>

// Keep orLibrary's own copy of the hook out
#emitfirst {
    Constant orHookWriteAfterEntry_STAGE 99; #ifdef orHookWriteAfterEntry_STAGE; #endif;
}
