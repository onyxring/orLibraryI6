/* -----------------------------------------------------------------------------
    orPlayerCommandQueue.bgl - Bindings for orLibrary's orPlayerCommandQueue extension
    Commands a program queues to run on the player's behalf, as though typed.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
#include "_orHookBanner"
#include "_orInfExt"
#include "orUtilBuf"
#include "_orHookInformLibrary"
#include "_orHookKeyboard"
#include "_orHookVerbs"
#includeI6 "orPlayerCommandQueue";

/// The queue of commands waiting to run for the player.
extern object playerCommands{
    void pushCommand(string cmd, bool isMeta = false, bool isSilent = false);      /// Add a command to the end of the queue.
    void preemptCommand(string cmd, bool isMeta = false, bool isSilent = false);   /// Add a command to run before anything queued.
    int  getLength();                                                              /// The number of queued commands.
    void clear();                                                                  /// Empty the queue.
}

/// Run `cmd` next in place of the current command, and return true: `bool s_look() { return redirectCommand("x jeep"); }`.
extern bool redirectCommand(string cmd);

extern const int noInferMessage;   /// A flag on a queued command that suppresses the parser's inference message.
