/* -----------------------------------------------------------------------------
    _orHookBanner.bgl - Bindings for orLibrary's _orHookBanner hook
    Adds orLibrary's version line to the game's banner. Every orLibrary binding includes it.

    Created by Jim Fisher (OnyxRing). Public domain, like the orLibrary it binds.
   -----------------------------------------------------------------------------*/
#once
// Keep orLibrary's own copy of the hook out
#emitfirst {
    Constant orLib_suppress_forced_banner_hook;
}
#include <bindings/i6StandardLibrary>

extern string orLibVersion;     /// The orLibrary's version number.
extern string orLibDateStamp;   /// The date of this orLibrary version.

// Add orLibrary's version line to the banner
replace void Banner(){
    replaced();
    print($"{bgl.printRules.italics}Using{bgl.printRules.roman} orLibrary v{orLibVersion} ({orLibDateStamp})^");
}
